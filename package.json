{
  "name": "novnc-sync",
  "version": "1.0.0",
  "description": "NoVNC群控同步器 - 跨客户端同步控制多台设备",
  "main": "index.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build:dir": "electron-builder --win --dir"
  },
  "author": "hogan-hong",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "iconv-lite": "^0.6.3"
  },
  "build": {
    "appId": "com.novnc.sync",
    "productName": "NoVNC同步器",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": ["portable"],
      "icon": null
    },
    "files": [
      "index.js",
      "sync.html",
      "配置文件.json",
      "package.json"
    ]
  }
}
