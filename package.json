{
  "name": "novnc-sync",
  "version": "1.0.0",
  "description": "NoVNC同步器 - 跨客户端同步控制，配合novnc-cef-client使用",
  "main": "index.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --x64",
    "build:win32": "electron-builder --win --ia32"
  },
  "author": "hogan-hong",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.novnc.sync",
    "productName": "NoVNC同步器",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "NoVNC同步器-${version}-${arch}.exe"
    },
    "files": [
      "index.js",
      "preload.js",
      "vnc-preload.js",
      "sync.html",
      "package.json",
      "配置文件.example.json"
    ],
    "extraResources": [
      {
        "from": "配置文件.example.json",
        "to": "配置文件.example.json"
      }
    ]
  }
}
